generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum PaymentMethod {
  ONLINE
  BANK_TRANSFER
  CASH
}

enum UserRole {
  SUPER_ADMIN
  FINANCE
  ADMIN
}

enum PaymentEntryType {
  FULL
  INSTALLMENT
}

enum PaymentEntryStatus {
  CONFIRMED
  REJECTED
}

enum TicketType {
  ADULT
  YOUTH
}

enum RegistrationType {
  CHURCH
  INDIVIDUAL
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum AttendanceEventType {
  CHECK_IN
  CHECK_OUT
}

enum TicketStatus {
  ACTIVE
  CANCELLED
  USED
}

// Preloaded official church list (from the General Secretary). Churches are
// NOT locked to a category in the data model — category is chosen manually
// at registration time and validated against attendee counts, since HQ data
// on church size is sometimes inaccurate.
model Church {
  id       String  @id // 3-digit code, e.g. "027" — used in the reference number
  name     String
  district String?
  country  String  @default("Fiji") // Fiji | Australia | New Zealand | USA | United Kingdom
  isActive Boolean @default(true)
  // HQ-reported size (SMALL | MEDIUM | LARGE | VERY LARGE), from the General
  // Secretary's membership list. Used only to pre-fill the category step at
  // registration — never enforced, since this data is sometimes inaccurate
  // and the registrant can always pick a different category manually.
  category String?

  registrations Registration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([country])
  @@index([name])
}

// Named staff accounts — replaces the single shared ADMIN_PASSWORD so payment
// approvals can be attributed to a real person ("Confirmed by: [Name]").
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  isActive     Boolean  @default(true)

  paymentsConfirmed    Payment[]            @relation("ConfirmedBy")
  passwordResetTokens  PasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
}

// Append-only finance ledger — one row per manual payment entry (full or
// installment). Corrections must be offsetting entries, never edits/deletes,
// to preserve the audit trail.
model Payment {
  id             String       @id @default(cuid())
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  registrationId String

  amount        Float
  entryType     PaymentEntryType
  status        PaymentEntryStatus @default(CONFIRMED)
  method        PaymentMethod
  referenceNote String?            @db.Text // Manual Override Box — bank ref, receipt no., teller, branch, notes
  installmentNo Int? // e.g. 2 of 6 — display only

  confirmedBy   User?    @relation("ConfirmedBy", fields: [confirmedById], references: [id])
  confirmedById String?
  confirmedAt   DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([registrationId])
  @@index([confirmedById])
}

model Event {
  id          String      @id @default(cuid())
  name        String
  description String?     @db.Text
  shortDesc   String? // One-liner for cards
  startDate   DateTime?
  endDate     DateTime?
  status      EventStatus @default(DRAFT)
  bannerUrl   String? // Hero image URL
  location    String? // General location label e.g. "Suva, Fiji"

  // Slug for friendly URLs e.g. "aog-100th-anniversary"
  slug String @unique

  venues        Venue[]
  registrations Registration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([status])
}

model Venue {
  id          String  @id @default(cuid())
  name        String
  description String? @db.Text
  address     String?
  city        String?
  capacity    Int
  isActive    Boolean @default(true)
  // Attendee age group this venue is dedicated to: "adults" | "youth" | "kids".
  // Drives automatic venue assignment at registration time — a venue with no
  // audienceType set is never auto-assigned. Null until an admin sets it.
  // NOTE: this replaces an earlier "one venue per church-size category" design
  // that didn't match how this event's venues are actually organized — pending
  // final client confirmation, per project notes.
  audienceType String?

  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  registrations Registration[]
  allocations   VenueAllocation[]

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  currentRegistrations Int      @default(0)
}

model Registration {
  id             String           @id @default(cuid())
  registrationId String           @unique // Custom format e.g. AG100-027VL301
  type           RegistrationType
  category       String // very-large-church, small-church, individual, etc.

  // Church (church-path registrations only — null for Individual/Missionary)
  churchId String?
  church   Church? @relation(fields: [churchId], references: [id])

  // Contact Info
  email String
  phone String?

  registrarName     String? // person filling out the form — distinct from pastorName
  contactPreference String? // "church" | "personal"
  contactPhone      String?
  contactEmail      String?

  // Specific Data (JSON for flexibility between Church/Individual)
  formData Json

  // Attendees — adults/youth/kids only apply to church-path registrations;
  // numberOfAttendees stays the authoritative total for every path.
  numberOfAttendees Int        @default(1)
  adults            Int        @default(0)
  youth             Int        @default(0)
  kids              Int        @default(0)
  attendees         Attendee[]

  // Event & Venue
  eventId String
  event   Event  @relation(fields: [eventId], references: [id])
  // Nullable: a registration's adults/youth/kids now split across separate
  // venues (see VenueAllocation) rather than booking into one single venue.
  // Kept for backwards compat with any legacy single-venue registrations.
  venueId String?
  venue   Venue?  @relation(fields: [venueId], references: [id])
  venueAllocations VenueAllocation[]

  // Payment
  fee              Float
  paymentMethod    PaymentMethod
  paymentStatus    PaymentStatus @default(PENDING)
  paymentSessionId String? // For ANZ eGate
  paymentRef       String? // Success Indicator or Bank Ref

  // Installment plan (manual tracking only — actual payments are logged via Payment rows)
  paymentType         String    @default("full") // "full" | "partial"
  installmentCount    Int? // 5–10 when partial
  installmentDeadline DateTime?

  payments Payment[]

  checkedInAt      DateTime? // Legacy — first ever check-in timestamp (kept for backwards compat)
  checkIns         DailyCheckIn[]
  attendanceEvents AttendanceEvent[]
  tickets          Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([registrationId])
  @@index([email])
  @@index([eventId])
  @@index([venueId])
  @@index([churchId])
}

// Records how a registration's headcount was split across venues by age
// group (one row per adults/youth/kids bucket that had a matching venue).
// This is what actually drives Venue.currentRegistrations now — Registration
// no longer books into a single venue.
model VenueAllocation {
  id             String       @id @default(cuid())
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  venueId        String
  venue          Venue        @relation(fields: [venueId], references: [id])
  audienceType   String // "adults" | "youth" | "kids"
  count          Int

  createdAt DateTime @default(now())

  @@unique([registrationId, audienceType])
  @@index([venueId])
}

// One row per attendee per event day — enables daily refresh of check-ins
model DailyCheckIn {
  id             String       @id @default(cuid())
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  registrationId String

  checkInDate String // YYYY-MM-DD — Fiji local date
  checkedInAt DateTime @default(now()) // Exact UTC timestamp

  // Optional: which device / admin performed the check-in
  deviceLabel String?

  // Ticket-based check-in (new) — takes priority over registrationId if set
  ticketId String?
  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([registrationId, checkInDate])
  @@unique([ticketId, checkInDate])
  @@index([checkInDate])
  @@index([registrationId])
}

model Attendee {
  id             String       @id @default(cuid())
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String
  email     String?
  phone     String?

  createdAt DateTime @default(now())
}

// Append-only attendance event log — every scan (check-in / check-out / re-entry)
model AttendanceEvent {
  id             String       @id @default(cuid())
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  registrationId String

  eventDate String // YYYY-MM-DD Fiji local date
  type      AttendanceEventType
  timestamp DateTime            @default(now())

  // Flagged when a checkout is recorded with no prior check-in for that day
  isFlagged  Boolean @default(false)
  flagReason String?

  // Ticket-based (new)
  ticketId String?
  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([registrationId])
  @@index([eventDate])
  @@index([isFlagged])
}

model EmailTemplate {
  id          String   @id
  subject     String   @db.Text
  preHeading  String   @default("") @db.Text
  heading     String   @default("") @db.Text
  bodyHtml    String   @default("") @db.Text
  ctaText     String   @default("")
  ctaUrl      String   @default("")
  closingHtml String   @default("") @db.Text
  updatedAt   DateTime @updatedAt
}

// Single-row site configuration — always one row with id="default"
model SiteConfig {
  id                       String   @id @default("default")
  bankName                 String   @default("")
  bankAccountName          String   @default("")
  bankAccountNumber        String   @default("")
  bankBranch               String   @default("")
  notificationEmail        String   @default("timoci@pacificbedbank.com")
  financeNotificationEmail String   @default("aogfj_finance@connect.com.fj")
  updatedAt                DateTime @updatedAt
}

// One ticket per seat purchased — each has its own unique QR code.
// ticketType is ADULT or YOUTH only — there is no KIDS value, so Kids
// attendees structurally cannot be issued a ticket/QR code.
model Ticket {
  id             String       @id @default(cuid())
  ticketNumber   String       @unique // e.g. AOG-TKT-00001
  ticketType     TicketType   @default(ADULT)
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  registrationId String
  status         TicketStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())

  dailyCheckIns    DailyCheckIn[]
  attendanceEvents AttendanceEvent[]

  @@index([registrationId])
  @@index([ticketNumber])
}
